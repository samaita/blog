# SPA fallback for /projects/address-quality (Cloudflare Pages).
# Rules are narrow so real files (images, assets, benchmark reports) are served
# directly and never rewritten by the SPA fallback. Rewrites apply before static
# assets, so only the SPA routes below map to index.html.
/projects/address-quality/benchmark/*/ /projects/address-quality/benchmark/:splat/ 200
/projects/address-quality/docs /projects/address-quality/ 200
/projects/address-quality/playground /projects/address-quality/ 200
/projects/address-quality/benchmark /projects/address-quality/ 200
/projects/address-quality/benchmark/* /projects/address-quality/ 200
